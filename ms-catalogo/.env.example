# ms-catalogo · EC2 A · copiar como /opt/mesatech/.env y completar (chmod 600). NUNCA subir el .env real.
SERVER_PORT=8082

# RDS Catalogo (instancia exclusiva)
DB_URL=jdbc:mysql://mesatech-catalogo-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:3306/catalogo
DB_USER=app_catalogo
DB_PASSWORD=cambiar_esta_clave

# RabbitMQ (IP PRIVADA de la EC2 C)
RABBIT_HOST=172.31.0.0
RABBIT_PORT=5672
RABBIT_VHOST=mesatech
RABBIT_USER=catalogo_publicador
RABBIT_PASSWORD=cambiar_esta_clave
