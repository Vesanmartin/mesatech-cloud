# ms-solicitudes · EC2 B · copiar como /opt/mesatech/.env y completar (chmod 600). NUNCA subir el .env real.
SERVER_PORT=8081

# RDS Solicitudes (instancia exclusiva, distinta de la de Catalogo)
DB_URL=jdbc:mysql://mesatech-solicitudes-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:3306/solicitudes
DB_USER=app_solicitudes
DB_PASSWORD=cambiar_esta_clave

# RabbitMQ (IP PRIVADA de la EC2 C)
RABBIT_HOST=172.31.0.0
RABBIT_PORT=5672
RABBIT_VHOST=mesatech
RABBIT_USER=solicitudes_consumidor
RABBIT_PASSWORD=cambiar_esta_clave
